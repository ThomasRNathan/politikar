# politikar : example environment configuration.
#
# Bootstrap (Vercel-linked) :
#   vercel link --yes --project politikar
#   vercel env pull .env.local --yes
#
# Marketplace integrations (Neon, Vercel Blob) auto-provision their env
# vars into the project. After enabling each integration, re-run
# `vercel env pull .env.local --yes` to refresh locally.
#
# For Python services (apps/api, apps/workers), copy this file to
# apps/api/.env and apps/workers/.env and fill in manually.

# =======================================================================
# ZERO-COST STACK (recommended at MVP)
# =======================================================================
# All of the following can be provisioned at $0 / month at our volumes.

# ---- LLM : Mistral La Plateforme (free tier) ---------------------------
# Sign up at https://console.mistral.ai/ → API Keys → create a key.
# Free tier covers our MVP volume largely (~50M tokens/mo needed, ~1B/mo
# quota). API is OpenAI-compatible ; we use the mistralai SDK.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Forces which provider extraction.py uses when multiple are configured.
# `auto` (default) picks Mistral first, then Anthropic. Override with
# `mistral` or `anthropic`.
POLITIKAR_LLM_PROVIDER=auto

# ---- Embeddings : Voyage AI (free tier 50M tokens/mo) ------------------
# Sign up at https://voyageai.com . MVP volume ~500k tokens/mo, ~1 % of
# the free quota.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large

# ---- DB : Neon Postgres via Vercel Marketplace -------------------------
# Provision via : Vercel dashboard → Storage → Marketplace → Neon → Free.
# Vercel auto-injects DATABASE_URL and DATABASE_URL_UNPOOLED. pgvector
# supported on Neon ; no auto-pause on active projects.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---- Vercel Blob : JSON snapshots for the cron --------------------------
# Provision via : Vercel dashboard → Storage → Create Blob Store.
# Auto-injects BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# ---- Vercel Cron : daily ingestion --------------------------------------
# Auto-injected by Vercel on cron invocations. Set manually for local dev
# so `curl http://localhost:3000/api/cron/daily` can hit the route.
CRON_SECRET=please-change-me-in-dev

# =======================================================================
# OPTIONAL PAID PROVIDERS (drop-in replacements)
# =======================================================================

# ---- LLM : Anthropic Claude (paid, used for high-stakes verifications) -
# Get a key at https://console.anthropic.com . API billing is separate
# from any Claude.ai chat subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Transcription : OpenAI Whisper (paid, needed only for audio) ------
OPENAI_API_KEY=

# ---- Supabase (alternative to Neon, paid Pro tier needed for prod) -----
# Only fill if you opted for Supabase instead of Neon. Then DATABASE_URL
# above must be your Supabase Postgres connection string.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Inngest (alternative to Vercel Cron, only if multi-step durable) --
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# =======================================================================
# OBSERVABILITY (free tiers everywhere)
# =======================================================================

# Sentry free tier : 5k events / mo.
SENTRY_DSN=

# =======================================================================
# politikar local dev
# =======================================================================

# Static bearer token used by FastAPI admin auth in dev. Replace with
# Supabase / Clerk / custom JWT verification before opening admin endpoints.
POLITIKAR_ADMIN_TOKEN=please-change-me-in-dev
