# politikar : example environment configuration.
# Copy to .env.local for the web app, .env for Python services. Never
# commit a populated copy. Vercel deployments source these from the
# Vercel dashboard (Production / Preview / Development scopes).

# ---- LLM ---------------------------------------------------------------
# Anthropic Claude. Required for claim extraction, classification, and
# the verification cascade. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Default model used by extraction. Cf PROMPTS.md.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Embeddings --------------------------------------------------------
# Voyage AI. Required for claim deduplication and semantic search.
# Get a key at voyageai.com.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large

# ---- Transcription -----------------------------------------------------
# OpenAI Whisper API for audio/video transcription (Élysée videos,
# YouTube interviews). Optional at MVP if no audio sources are wired.
OPENAI_API_KEY=

# ---- Supabase ----------------------------------------------------------
# Project URL and keys. Get them from
# https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret for admin auth verification by FastAPI.
SUPABASE_JWT_SECRET=

# Direct Postgres URL for the workers (asyncpg).
DATABASE_URL=

# Public read-only env for the Next.js front (same project, anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Inngest -----------------------------------------------------------
# https://app.inngest.com → settings → keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Sentry ------------------------------------------------------------
# Optional. Free tier is enough at MVP.
SENTRY_DSN=

# ---- politikar local dev ----------------------------------------------
# Static bearer token used by FastAPI admin auth in dev only. Replace
# with Supabase JWT verification in prod (see apps/api/README.md).
POLITIKAR_ADMIN_TOKEN=please-change-me-in-dev
